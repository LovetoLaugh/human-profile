# Leave blank to keep the anonymous demo working with sign-in unavailable.
# Copy real matching keys from your Clerk application into .env.local (never commit it).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Routes are also fixed in the account layout for consistent sign-in/sign-up completion.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/me
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/me

# Optional: simulate hosted temporary storage locally. Default is local file storage.
# HUMAN_PROFILE_MODE=public-demo
# HUMAN_PROFILE_DATA_DIR=/absolute/path/outside/git

# Private owner persistence: npm run dev defaults to local files.
# Vercel and NODE_ENV=production require DynamoDB; there is no temporary fallback.
AWS_REGION=
HUMAN_PROFILE_DYNAMODB_TABLE=
# Optional development opt-in:
# HUMAN_PROFILE_OWNER_STORAGE=dynamodb
# Optional DynamoDB Local endpoint (development only):
# HUMAN_PROFILE_DYNAMODB_ENDPOINT=http://localhost:8000
# AWS SDK uses its standard server-side credential chain. If your host needs
# environment credentials, configure these securely there, never in Git:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
